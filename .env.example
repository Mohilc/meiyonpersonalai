# ==============================================================================
# Meiyon Personal AI Manager - Environment Configuration Template
# Copy this file to .env and fill in your keys and credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & AUTONOMY SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Meiyon Personal AI"
AUTONOMY_MODE="SUPERVISED"         # Options: ASSISTED (Mode A), SUPERVISED (Mode B), RESTRICTED_AUTONOMY (Mode C)
TIMEZONE="Asia/Kolkata"
DEBUG="false"

# ------------------------------------------------------------------------------
# 2. NVIDIA NIM MULTI-MODEL POOL (AI Reasoning & Copilot)
# Get your free NVIDIA NIM API keys at: https://build.nvidia.com
# ------------------------------------------------------------------------------
AI_PROVIDER="nvidia_nim"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Deep Reasoning & Architecture Planning (Mistral Large 4 1T MoE)
NVIDIA_REASONING_KEY="nvapi-xxxx"
NVIDIA_REASONING_MODEL="mistralai/mistral-large-4-1t-a52b"

# Sub-second Fast Conversational Copilot (Nemotron 3.5 Bolt)
NVIDIA_GENERAL_KEY="nvapi-xxxx"
NVIDIA_GENERAL_MODEL="nvidia/nemotron-3.5-bolt-e4b"

# Multimodal Vision & Image Analysis (Mistral Large 4 / Meta Muse Glimmer)
NVIDIA_VISION_KEY="nvapi-xxxx"
NVIDIA_VISION_MODEL="mistralai/mistral-large-4-1t-a52b"
NVIDIA_MUSE_KEY="nvapi-xxxx"
NVIDIA_MUSE_MODEL="meta/muse-glimmer-30b"
NVIDIA_MISTRAL_KEY="nvapi-xxxx"
NVIDIA_MISTRAL_MODEL="mistralai/mistral-large-4-1t-a52b"

# Optional: Google Gemini API Fallback
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2B. GOOGLE SEARCH & LIVE WEB INTELLIGENCE (SerpApi)
# Get your SerpApi key at: https://serpapi.com
# ------------------------------------------------------------------------------
SERPAPI_API_KEY=""
SERPAPI_DEFAULT_LOCATION="India"
SERPAPI_DEFAULT_GL="in"
SERPAPI_DEFAULT_HL="en"

# ------------------------------------------------------------------------------
# 3. MODEL CONTEXT PROTOCOL (MCP): GMAIL INTEGRATION
# Generate a Google 16-character App Password at:
# https://myaccount.google.com/apppasswords (select app: "Personal AI Manager")
# ------------------------------------------------------------------------------
GMAIL_MCP_ENABLED="true"
GMAIL_ADDRESS="mohil@example.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
GMAIL_CREDENTIALS_PATH=""

# ------------------------------------------------------------------------------
# 4. MODEL CONTEXT PROTOCOL (MCP): LINKEDIN INTEGRATION
# Option A (Recommended): Zapier MCP LinkedIn Server (live OAuth - no cookie scraping)
#   Get your Zapier MCP server ID at: https://mcp.zapier.com
# Option B: LinkedIn li_at session cookie (copy from browser DevTools)
# ------------------------------------------------------------------------------
LINKEDIN_MCP_ENABLED="true"

# Option A: Zapier MCP LinkedIn (preferred - paste your server UUID from mcp.zapier.com)
ZAPIER_LINKEDIN_MCP_ID="your-zapier-mcp-server-uuid-here"
ZAPIER_LINKEDIN_MCP_URL="https://mcp.zapier.com/api/mcp/s/your-zapier-mcp-server-uuid-here/mcp"

# Option B: LinkedIn li_at session cookie
# Copy from browser: F12 -> Application -> Cookies -> linkedin.com -> li_at
LINKEDIN_LI_AT_COOKIE=""
LINKEDIN_HEADLESS="true"

# Fallback: if no live credentials are set, safe sandbox simulated data is used
MCP_SIMULATION_FALLBACK="true"

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT INTEGRATION (@Meiyon_ai_bot)
# Create a bot via @BotFather on Telegram to get your token.
# To find your chat ID, send a message to @userinfobot on Telegram.
# ------------------------------------------------------------------------------
TELEGRAM_ENABLED="true"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_ID=""        # Restricts bot access strictly to your Telegram account

# ------------------------------------------------------------------------------
# 6. WHATSAPP CHAT INTEGRATION (Twilio)
# Find your Account SID and Auth Token at: https://console.twilio.com
# ------------------------------------------------------------------------------
WHATSAPP_ENABLED="true"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+17372508034"
TWILIO_CONTENT_SID="HXfe5ab5f00277942d4d4200328b4d403c"
WHATSAPP_ALLOWED_NUMBER="+918590144798"  # Restricts WhatsApp access strictly to your number
