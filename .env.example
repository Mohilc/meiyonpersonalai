# Personal AI Manager Environment Configuration
APP_NAME="Personal AI Manager"
AUTONOMY_MODE="ASSISTED"
TIMEZONE="Asia/Kolkata"

# MCP: Gmail Configuration
# Option A (Recommended): Generate an App Password in your Google Account:
# Go to https://myaccount.google.com/security -> 2-Step Verification -> App passwords
# Create one named "Personal AI Manager" and paste the 16-character code below:
GMAIL_ADDRESS="mohil@example.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Option B: Path to OAuth2 credentials.json (optional)
GMAIL_CREDENTIALS_PATH=""

# MCP: LinkedIn Configuration
# Extract your 'li_at' session cookie from linkedin.com (F12 -> Application -> Cookies -> li_at)
LINKEDIN_LI_AT_COOKIE=""
LINKEDIN_HEADLESS="true"

# Fallback: if credentials are empty, safe simulated recruiter data is used for testing
MCP_SIMULATION_FALLBACK="true"

# AI Reasoning & Multi-Model Pool
AI_PROVIDER="nvidia_nim"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# 1. Reasoning & Planning (Nemotron 3.5 Lightning)
NVIDIA_REASONING_KEY="nvapi-xxxx"
NVIDIA_REASONING_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# 2. General Text & Fast Generation (Meta Muse Glimmer)
NVIDIA_GENERAL_KEY="nvapi-xxxx"
NVIDIA_GENERAL_MODEL="meta/muse-glimmer-30b"

# 3. Vision & Multimodal (DiffusionGemma)
NVIDIA_VISION_KEY="nvapi-xxxx"
NVIDIA_VISION_MODEL="google/diffusiongemma-26b-a4b-it"

# Google Gemini (Optional)
GEMINI_API_KEY=""
